// Guide text for the Ember Clans (format: docs/17-unit-rosters.md#guide-data,
// docs/08-ui-ux.md#guide). Numbers are not written here: the Guide reads them
// from data/rosters/ember_clans.ron. Every building and unit in the roster
// needs an entry (a test checks), summaries are at most 350 characters and
// taglines at most 80, plain ASCII.
//
// buildings: name, summary, notes. A note is (what, benefit) for a main
// building's tier upgrade (named by the building it makes) or "Research".
// units: name, tagline, summary. Units, summoned units and heroes.
(
    faction: EmberClans,
    buildings: [
        (
            name: "Clan Hall",
            blurb: "Your starting base: trains Hands and takes Grub and Marrow. Upgrade it to the Castle Keep for the mid game.",
            summary: "Your starting base: Hands drop Grub and Marrow here, it trains new Hands, and regiments reinforce beside it. It is Fortified, so rams hit it for triple damage. Upgrade it to the Castle Keep once income allows; that opens samurai, cavalry, rocket carts and a second hero. Workers clear woods and scrub (S) to make room; cleared ground is open.",
            notes: [
                ("Castle Keep", "The gate to the mid game: samurai, cavalry, rocket carts, War Kites and a second hero. It costs Marrow, so claim a Marrow vein first."),
            ],
            tips: [
                (icon: Grub, text: "Queue Hands early and put them on the nearest seeps, since the hall takes Grub and Marrow."),
                (icon: Marrow, text: "Claim a Marrow vein early, since the Castle Keep upgrade costs Marrow on top of Grub."),
                (icon: Alarm, text: "Keep spears close to the hall, since rams hit Fortified halls for triple damage."),
            ],
        ),
        (
            name: "Castle Keep",
            blurb: "Tier 2 of the Clan Hall: unlocks the Stables, Kite Loft and tier-2 regiments. Upgrade once your army pays for itself.",
            summary: "The Clan Hall's second tier. It keeps working as a hall while it upgrades and raises your supply cap. It unlocks the Stables and Kite Loft and every tier-2 regiment. Upgrade again for monsters once your army is paying for itself.",
            notes: [
                ("Daimyo's Citadel", "The late game: the Oni-Bound monster, the third hero and the top upgrades (not designed yet). Expensive, so upgrade when you hold a second base."),
            ],
            tips: [
                (icon: Hammer, text: "Upgrade once you can pay 300 Grub and 100 Marrow; the hall keeps working during the upgrade."),
                (icon: Supply, text: "Upgrade before supply caps your army, since the Keep adds more supply than the Hall."),
                (icon: Sword, text: "Once the Keep stands, queue Katana Samurai at the Dojo as your shock core."),
            ],
        ),
        (
            name: "Daimyo's Citadel",
            blurb: "Tier 3 of the Clan Hall: opens the third hero slot and lets the Ancestor Shrine bind the Oni-Bound.",
            summary: "The final tier of the main building. It raises the supply cap again, lets the Ancestor Shrine bind the Oni-Bound and opens the third hero slot. Nothing is left to upgrade, so spend on armies and defence from here.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Upgrade only when you hold a second base, since it costs 600 Grub and 250 Marrow."),
                (icon: Hold, text: "Once it stands, your Ancestor Shrine can bind the Oni-Bound and a third hero slot opens."),
                (icon: Sword, text: "Spend Grub on armies and defence from here, since no main-building upgrade is left."),
            ],
        ),
        (
            name: "Outpost Hall",
            blurb: "A forward hall at a far seep or vein: a Grub and Marrow drop-off and reinforcement point. Trains nothing.",
            summary: "A cheaper hall for expansions: a drop-off for Grub and Marrow and a reinforcement point beside a far seep or vein. It trains nothing and cannot be upgraded, so it is a forward base rather than a second home. Build it when home seeps run low or to claim Marrow. Woods and scrub are cleared first, which takes the worker longer.",
            notes: [],
            tips: [
                (icon: Flag, text: "Place it beside a far seep or Marrow vein to make a forward drop-off and reinforcement point."),
                (icon: Grub, text: "Build it once home seeps run low; it is cheaper than a Clan Hall and takes Grub and Marrow."),
                (icon: Alarm, text: "Screen it with spears, since it trains nothing and cannot be upgraded."),
            ],
        ),
        (
            name: "Farmstead",
            blurb: "Housing: raises your supply cap. Build one before you hit the cap, and keep it back from the front.",
            summary: "Housing: every regiment uses supply, and each Farmstead raises the cap. Cheap and quick to raise, so build one before you hit the cap, not after, and keep them away from the front where raiders will burn them.",
            notes: [],
            tips: [
                (icon: Supply, text: "Raise one before you hit the supply cap, since each Farmstead adds 10 supply."),
                (icon: Alarm, text: "Keep Farmsteads back from the front, since raiders will burn them."),
                (icon: Hammer, text: "Raise several at once from behind the hall, since each costs 80 Grub and goes up quickly."),
            ],
        ),
        (
            name: "Granary",
            blurb: "A Grub drop-off beside far seeps so Hands walk less. Its economy research is not designed yet.",
            summary: "A Grub drop-off to build beside seeps so Hands walk less; put one at every far seep. It is also meant to research the Clans' economy upgrades, but no research is designed yet, so for now it is a shorter walk and nothing more.",
            notes: [
                ("Research", "Economy upgrades are planned for the Granary. No research, costs or times are designed or built yet, so nothing can be bought here today."),
            ],
            tips: [
                (icon: Grub, text: "Put one beside each far seep so Hands walk less on every trip."),
                (icon: Marrow, text: "It takes Grub only, so send Marrow to a Clan Hall or Outpost Hall instead."),
                (icon: Book, text: "Ignore its research for now, since no economy upgrades are designed or built yet."),
            ],
        ),
        (
            name: "Dojo",
            blurb: "Trains Yari spears, Yumi archers and, at tier 2, Katana Samurai. Your first military building; raise it near the front.",
            summary: "The infantry barracks: Yari spearmen and Yumi archers at tier 1, Katana Samurai at tier 2. Regiments reinforce beside it, so raise it near the front. It is your first military building and the one you will build most; without it you have no army.",
            notes: [],
            tips: [
                (icon: Flag, text: "Place it near the front, since regiments reinforce beside it and you will build it most."),
                (icon: Spear, text: "Train Yari spears first to anchor the line, with Yumi archers kept behind them."),
                (icon: Sword, text: "Add Katana Samurai once the Castle Keep stands, since they need Marrow as well."),
            ],
        ),
        (
            name: "Stables",
            blurb: "Trains Mounted Samurai and Yabusame Riders. Tier 2, needs Marrow. Cavalry ride down archers and routing troops.",
            summary: "Trains Mounted Samurai (shock cavalry) and Yabusame Riders (horse archers). Tier 2 and needs Marrow. Regiments reinforce beside it. Cavalry ride down archers, artillery and routing troops; keep spears nearby for the enemy's own horse.",
            notes: [],
            tips: [
                (icon: Spear, text: "Keep spear regiments nearby, since the enemy's own horse will come for your cavalry."),
                (icon: Charge, text: "Send Mounted Samurai at archers, artillery and routing troops, not into braced spears."),
                (icon: Marrow, text: "Claim Marrow first, since the Stables and the cavalry they train both cost Marrow."),
            ],
        ),
        (
            name: "Ember Workshop",
            blurb: "Builds Battering Rams, then Rocket Carts at tier 2. Build one before you attack: rams break Fortified halls and walls.",
            summary: "Builds Battering Rams at tier 1 and Ember Rocket Carts at tier 2, so it is your only siege and artillery. Raise one before you attack a base: rams are how you break Fortified halls, towers and walls.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Build one or two rams before you assault a base; they break Fortified halls, towers and walls."),
                (icon: Spear, text: "Escort rams with spears, since rams cannot fight and cavalry or heavy infantry catch them."),
                (icon: Alarm, text: "Keep rocket carts behind a spear line, since their salvos can hit your own troops."),
            ],
        ),
        (
            name: "Kite Loft",
            blurb: "Builds War Kites, the Clans' flyers: fast scouts that set structures burning. Tier 2, needs Marrow.",
            summary: "Builds War Kites, the Clans' only flyers: fast scouts that see far and set structures burning. Tier 2 and needs Marrow. Build one to scout, to hunt workers and artillery, or to burn walls out from under a defender.",
            notes: [],
            tips: [
                (icon: Bow, text: "Scout with War Kites, which see 18 tiles; only archers and other flyers can answer them."),
                (icon: Marrow, text: "Save Marrow for it, since the Kite Loft and each War Kite both cost Marrow."),
                (icon: Alarm, text: "Use kites to hunt workers and artillery, or to set walls burning under a defender."),
            ],
        ),
        (
            name: "Ancestor Shrine",
            blurb: "Hires and revives heroes, and each finished Shrine earns Honor. Build it early, since heroes lead your army.",
            summary: "Hires and revives heroes and holds the Honor Edicts; each finished Shrine earns a point of Honor every 30 seconds. Build it early, since heroes lead your army and Honor is the Clans' faction power. At tier 3 it binds the Oni-Bound.",
            notes: [],
            tips: [
                (icon: Heart, text: "Build it early and revive fallen heroes here, since heroes lead your army."),
                (icon: Flag, text: "Each finished Shrine earns Honor every 30 seconds, so a second Shrine adds to your Honor."),
                (icon: Sword, text: "Save Honor for a decisive fight, since Spectral Samurai fade after 60 seconds."),
            ],
        ),
        (
            name: "Forge",
            blurb: "Nothing to research yet: weapon and armour upgrades are not designed or built. Plan one for later.",
            summary: "Meant to research weapon and armour upgrades. No upgrades are designed or built yet, so today it does nothing you can buy. Plan one after your first military building, ready for when research arrives.",
            notes: [
                ("Research", "Weapon and armour upgrades are planned for the Forge. No research, costs or times are designed or built yet, so nothing can be bought here today."),
            ],
            tips: [
                (icon: Book, text: "Build it after your first military building, but expect nothing to buy there until research arrives."),
                (icon: Grub, text: "Spend early Grub on Hands and the Dojo instead, since the Forge does nothing you can buy yet."),
            ],
        ),
        (
            name: "Watchtower",
            blurb: "Two archers that shoot ground and air. A cheap guard for seeps and approaches against lone raiders and flyers.",
            summary: "Two archers that shoot ground and air: siege engines first, then whoever attacks your buildings, then the nearest. Right-click an enemy with it selected to pick its target. A cheap deterrent for seeps and approaches: it will not stop an army, but it punishes lone raiders and flyers. It is Fortified, so rams and fire still beat it.",
            notes: [],
            tips: [
                (icon: Alarm, text: "Place it at seeps and approaches to punish lone raiders and flyers, since it will not stop an army."),
                (icon: Spear, text: "Guard it with spears, since rams and Fire Arrows still beat it."),
                (icon: Bow, text: "Count on it to shoot down War Kites and flyers as well as ground troops."),
            ],
        ),
        (
            name: "Ballista Yagura",
            blurb: "Bolt tower: a heavy bolt that runs down a single file. Strong against columns, monsters, riders and engines.",
            summary: "Bolt tower: one heavy bolt every 5 seconds that runs down a single file of soldiers, twice as hard on monsters, riders and engines. It shoots siege engines first, then big soldiers, then whoever attacks your buildings. Right-click an enemy with it selected to pick its target. A shield wall does not stop the bolt.",
            notes: [],
            tips: [
                (icon: Alarm, text: "Strong against columns, monsters and cavalry, since each bolt runs down a whole file."),
                (icon: Spear, text: "Weak against wide lines of small soldiers, so keep spears in front of it."),
                (icon: Flag, text: "Place it where enemy columns will march, so each bolt has a file to run down."),
            ],
        ),
        (
            name: "Horoku Tower",
            blurb: "Blast tower: fire-pots into the fullest enemy block, harder the more packed it is. Cannot hit enemies close to it.",
            summary: "Blast tower: six shots every 6 seconds into the fullest enemy block in range, harder the more packed it is, with half splashing on nearby regiments. Siege engines first. It cannot hit enemies within 8 tiles of it, so guard it with troops. Its fire-pots leave burning ground for 8 seconds and set woods alight.",
            notes: [],
            tips: [
                (icon: Spear, text: "Guard it with spears close by, since nothing within 8 tiles of it can be hit."),
                (icon: Alarm, text: "Burning ground hurts enemies standing in it, so it is best against crowds that stay put."),
                (icon: Hammer, text: "Clear woods and scrub around it, since its fire-pots set them alight."),
            ],
        ),
        (
            name: "Palisade",
            blurb: "A wall you draw, built a tile at a time by a worker. Fire burns it and rams break it.",
            summary: "A wall you draw: press and drag for a smooth curve, or click corner to corner for sharp ones; right-click to finish. Shift keeps it straight in 15-degree steps; O draws a closed ring; B plans a blueprint. Priced and built a tile at a time by a worker. Fire Arrows burn it and rams break it.",
            notes: [
                ("Stone Wall", "Twice and a half as tough and no longer burns like logs. Raise the stretch facing the enemy first."),
            ],
            tips: [
                (icon: Alarm, text: "Close a choke point end to end, since regiments file through a gap just one tile wide."),
                (icon: Hammer, text: "B plans it as a blueprint: workers pay tile by tile when you press A or right-click the blue tiles."),
                (icon: Move, text: "Press O to ring your base: it leans on cliffs and marks where a Gate would suit."),
            ],
        ),
        (
            name: "Stone Wall",
            blurb: "Tier 2 of the Palisade: 2.5 times as tough. Select a Palisade and press U to raise its stretch.",
            summary: "Level 2 of the Palisade: a sloped stone wall with a plaster face, 2.5 times as tough. Select a Palisade and press U: the whole joined stretch is paid now and a worker raises it a tile at a time, and the wall stays up meanwhile.",
            notes: [
                ("Castle Wall", "The toughest wall the Clans build: four times a Palisade. Needs a Castle Keep."),
            ],
            tips: [
                (icon: Flag, text: "Right-click it with foot or archers to man it: they shoot further and take half from arrows."),
                (icon: Hammer, text: "Select the wall and press U: the joined stretch is paid now, then raised a tile at a time."),
                (icon: Alarm, text: "Raise the side facing the enemy first; it stays standing while workers raise it."),
            ],
        ),
        (
            name: "Castle Wall",
            blurb: "Tier 3 of the Palisade: 4 times as tough, with loopholes for archers. Needs a Castle Keep; press U on a Stone Wall.",
            summary: "Level 3, the top: a castle wall with loopholes and corner turrets, 4 times as tough as a Palisade. Needs a Castle Keep. Select a Stone Wall and press U to raise its stretch. Its twist: a stone falls every 3 s on each regiment hacking at it, and your archers on it shoot through loopholes, a quarter faster.",
            notes: [],
            tips: [
                (icon: Flag, text: "Right-click it with foot or archers to man it: they shoot further and take half from arrows."),
                (icon: Alarm, text: "Right-click an enemy raised wall with foot or archers to climb it; spears stop climbers."),
                (icon: Grub, text: "Each tile costs 20 Grub and 5 Marrow, paid for the whole stretch up front."),
            ],
        ),
        (
            name: "Gate",
            blurb: "A gate in your wall: your side walks through and enemies don't. Set it Auto, Locked or Open.",
            summary: "A wall segment your side walks through and enemies don't. Select it to set Auto (opens as your regiments march up, shuts 2 s after; troops in the gateway hold it open), Locked (shut to everyone) or Open (anyone can pass). Enemies break it down like any wall.",
            notes: [
                ("Yagura Gatehouse", "Half as tough again, with a walkway over the door for archers or foot. It goes up on its own, with no worker, and the door keeps working."),
            ],
            tips: [
                (icon: Flag, text: "Select it, then Q, W or E: Auto, Locked or Open. Lock it under attack; open it for a sally."),
                (icon: Hammer, text: "Place it on your own Palisade and it replaces that stretch: R turns it to run along the wall."),
                (icon: Hammer, text: "Press V to raise it to a Yagura Gatehouse: archers or foot can man its top."),
            ],
        ),
        (
            name: "Yagura Gatehouse",
            blurb: "Tier 2 of the Gate: half as tough again, with a walkway for archers. Select a Gate and press V.",
            summary: "Level 2 of the Gate: a stone gatehouse with a timber yagura on top, half as tough again. Select a Gate and press V: it goes up on its own, with no worker, and the door keeps working. Archers or foot can man the walkway over the door, and it joins a raised wall beside it into one walkway.",
            notes: [],
            tips: [
                (icon: Flag, text: "Alt+right-click it with foot or archers to man it: they shoot further, take half from arrows."),
                (icon: Alarm, text: "Enemies can climb it on ladders; spears stop climbers. Lock the door under attack."),
                (icon: Move, text: "A raised wall touching it joins its walkway, so one regiment can hold both."),
            ],
        ),
        (
            name: "Timber Bridge",
            blurb: "Draw a bridge across a river. Workers build it from each bank, and anyone can cross it.",
            summary: "You draw it across a river: drag from bank to bank along a gentle curve, or click each bank for a straight one. [ and ] pick narrow, standard or wide (3 to 5 tiles), 3 Grub a tile. Hands build it out from the bank a plank-span at a time. Anyone can cross it; a broken tile drops its troops into the river.",
            notes: [
                ("Braced Timber Bridge", "Twice as tough against blows; later, debris in the river too."),
            ],
            tips: [
                (icon: Hammer, text: "Drag from dry land to dry land; it bends gently. [ and ] pick the width."),
                (icon: Move, text: "A Hand builds it from the bank and carries on across the river a tile at a time."),
                (icon: Alarm, text: "Enemies can cross it too, so guard it. A tile that falls drops troops into the river."),
            ],
        ),
        (
            name: "Braced Timber Bridge",
            blurb: "Tier 2 of the Timber Bridge: twice as tough. Select a bridge and press U to raise the whole joined span.",
            summary: "Level 2 of the Timber Bridge: cross-bracing and doubled pilings under the deck, twice as tough. Select a bridge and press U: the whole joined bridge is paid now and a Hand raises it a span at a time, and troops keep crossing meanwhile.",
            notes: [
                ("Stone-Footed Bridge", "More than three times as tough, and debris glances off its cutwaters."),
            ],
            tips: [
                (icon: Hammer, text: "Select the bridge and press U: the joined bridge is paid now, then raised a span at a time."),
                (icon: Move, text: "Troops keep crossing while it is raised; the deck never closes."),
                (icon: Alarm, text: "Upgrade bridges on rivers an enemy can reach first: they take blows and debris best."),
            ],
        ),
        (
            name: "Stone-Footed Bridge",
            blurb: "Tier 3 of the Timber Bridge: over three times as tough, and sheds debris. Needs a Castle Keep; press U on a braced one.",
            summary: "Level 3, the top: stone-footed piers with pointed cutwaters facing upstream, more than three times a plain bridge's toughness, and it sheds debris instead of catching it. Needs a Castle Keep. Select a Braced Timber Bridge and press U.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Select the bridge and press U: the joined bridge is paid now, then raised a span at a time."),
                (icon: Move, text: "Troops keep crossing while it is raised; the deck never closes."),
                (icon: Alarm, text: "Upgrade bridges on rivers an enemy can reach first: they take blows and debris best."),
            ],
        ),
        (
            name: "Stake Line",
            blurb: "Draw stakes that stop enemy riders and beasts dead; foot troops pass at half pace. Wears down each time.",
            summary: "A line of sharpened stakes you draw like a wall, at any angle, for 4 Grub a tile. Anyone walks through at half pace, but nobody charges through: enemy riders and beasts that run onto it are stopped dead, hurt and disordered. It wears down each time.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Draw it like a wall, at any angle. It costs little and goes up fast."),
                (icon: Spear, text: "Spearmen and archers can plant a free line with Plant stakes (C): stand 10 s."),
                (icon: Alarm, text: "Ranks that charge into it are stopped dead; keep your own charges off it."),
            ],
        ),
        (
            name: "Cart Barricade",
            blurb: "Draw a barricade nobody walks through; troops behind it take less from arrows and blows.",
            summary: "A line of overturned carts and logs you draw like a wall, for 8 Grub a tile. It blocks walking like a wall, and your troops within 2 tiles of it take 30 percent less from arrows and 20 percent less from blows to their front. Enemy troops get no cover from it.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Draw it like a wall, at any angle. It costs little and goes up fast."),
                (icon: Bow, text: "Put your archers and spears within 2 tiles behind it to take the cover."),
                (icon: Alarm, text: "It blocks your own troops too, so leave a gap where your line must pass."),
            ],
        ),
        (
            name: "Spike Pit",
            blurb: "A hidden trap: the first enemy regiment to step on it is thrown into disorder. Gone once sprung.",
            summary: "A hidden pit under a woven lid, for 15 Grub on one tile. The first enemy regiment to walk onto it falls in: its front rank is hurt and the regiment is thrown into disorder. Your enemies cannot see it, and once it is sprung it is gone.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Built by a worker like any building, on one tile. Nothing can be built on it."),
                (icon: Alarm, text: "Only you can see it. Enemies never see it, not even in the open."),
                (icon: Spear, text: "Dig it where a road narrows or at a gap in your walls. Your own troops walk over it safely."),
            ],
        ),
    ],
    units: [
        (
            name: "Hands",
            tagline: "Worker: gathers Grub and Marrow, builds and repairs.",
            summary: "The Clans' worker. Carries 10 Grub or 5 Marrow a trip to a Clan Hall or Granary, and builds and repairs every Clan structure. Poor fighters, so keep them out of raids. Train a steady stream early and put them on every seep. They can also clear woods, scrub and thicket (S); Hands fell and haul the trees, so timber pays more Grub than elsewhere.",
        ),
        (
            name: "Yari Ashigaru",
            tagline: "Spear line: stops cavalry, braces to hold ground.",
            summary: "The Clans' cheap, sturdy spear line. Reach lets the second rank fight, and Brace stops charges cold, so they anchor your front and answer cavalry. They lose to archers, heavy infantry and artillery, so keep Yumi behind them and build them first, in numbers.",
        ),
        (
            name: "Yumi Ashigaru",
            tagline: "Archers: volleys at range, Fire Arrows burn buildings.",
            summary: "Archers who shoot ground and air. Fire Arrows set structures alight for extra damage at the cost of a slower reload. They shred infantry in the open but are weak in melee and die to cavalry, so keep them behind spears or walls.",
        ),
        (
            name: "Battering Ram",
            tagline: "Siege: triple damage to Fortified buildings.",
            summary: "A covered ram that only harms structures (triple against Fortified halls, towers and walls) and takes half damage from ranged volleys. It cannot fight regiments, so escort it with spears. Build one or two before assaulting a base; cavalry and heavy infantry catch it.",
        ),
        (
            name: "Katana Samurai",
            tagline: "Elite heavy infantry: a Kiai shout shakes enemy morale.",
            summary: "Elite swordsmen with strong attack and defence. Kiai drains the morale of enemies in contact or within 6 tiles and lifts their own. They beat light infantry and spears but fear archers and monsters. Tier 2 and Marrow: your shock core once the Keep stands.",
        ),
        (
            name: "Mounted Samurai",
            tagline: "Shock cavalry: huge charge, rides down routers.",
            summary: "Heavy shock cavalry with the Clans' biggest charge bonus, and Wedge adds more. Ride Down adds 50% damage to routing regiments, so they finish a broken line. Spears and braced lines stop them; hit archers, artillery and flanks instead.",
        ),
        (
            name: "Yabusame Riders",
            tagline: "Horse archers: shoot on the move, skirmish by default.",
            summary: "Horse archers who loose volleys while moving, at reduced accuracy. They skirmish by default: hit, withdraw, repeat. Good for picking off archers and chasing workers, weak when pinned in melee. Fast enough to run from spears.",
        ),
        (
            name: "Ember Rocket Cart",
            tagline: "Artillery: long-range area fire that bleeds morale.",
            summary: "Long-range artillery. Each salvo bursts over 3 tiles and costs the regiments it hits extra morale. It cannot fire at targets closer than 10 tiles and can hit your own troops, so keep it behind a line of spears. Deadly to packed infantry, helpless once cavalry arrives.",
        ),
        (
            name: "War Kite",
            tagline: "Flyer: sees 18 tiles, burns structures.",
            summary: "A fast flying scout that sees 18 tiles instead of the usual 12 and drops fire pots that set structures burning. Fragile, but only archers and other flyers can answer it. Use it to scout, to snipe workers and artillery, and to burn walls.",
        ),
        (
            name: "Oni-Bound",
            tagline: "Monster: terror aura, breaks its chains without a hero.",
            summary: "A bound giant with huge hit points, crushing blows and a Terror Aura that bleeds enemy morale within 10 tiles. With no Clan hero within 20 tiles for 20 seconds it breaks its chains and attacks anything, so keep a hero close. Focused archers and heroes counter it. Tier 3.",
        ),
        (
            name: "Spectral Samurai",
            tagline: "Summoned samurai: last 60 s and never rout.",
            summary: "Called by the Ancestral Return Edict at a Shrine or hero. They fight like Katana Samurai but never rout, cost no supply and fade after 60 seconds. They cannot be trained, so spend the Honor on a decisive fight rather than in advance.",
        ),
        (
            name: "Fire Spirit",
            tagline: "Summoned flame spirit: ranged bolts that set fires.",
            summary: "Summoned by the Onmyoji's Fire Spirit ability. A single fast spirit with ranged bolts that set structures burning. It lasts 30 to 50 seconds by rank and never routs. Use it to burn buildings or harass archers; it cannot be trained.",
        ),
        (
            name: "The Daimyo",
            tagline: "Hero commander: rallies routers, bolsters defence.",
            summary: "A mounted commander who holds the army together: Rally ends routs, his aura raises melee defence, and the Shogun's Banner makes every Clan regiment steadier and faster. He can lock an enemy hero in a duel. Hire him first if your army is large.",
        ),
        (
            name: "The Ronin",
            tagline: "Hero duelist: blinks through lines, regains health alone.",
            summary: "A lone duelist with big melee damage. Iaijutsu Dash blinks through a line of enemies, Wind Cut hits a cone, and he heals when no friend is near. Thousand Cuts makes him untouchable while he carves nearby foes. Hunt archers and enemy heroes with him.",
        ),
        (
            name: "The Onmyoji",
            tagline: "Hero mystic: fire spirits, wards and scouting.",
