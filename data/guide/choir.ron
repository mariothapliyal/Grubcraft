// Guide text for the Shard Choir. Format and rules: see ember_clans.ron.
(
    faction: Choir,
    buildings: [
        (
            name: "Spire",
            blurb: "Your starting base: trains Tuners and Conductors and powers buildings within 8 tiles. Build the rest around it.",
            summary: "Your starting base. It builds Tuners and Conductors and powers buildings within 8 tiles; almost every other Choir building needs power, so build around it. Upgrade through the Cathedral and Grand Organ for walkers, cavalry, flyers and monsters. Workers clear woods and scrub (S) to make room; cleared ground is open.",
            notes: [
                ("Cathedral", "The mid game: Harmonic Walkers, Glass Striders, the Skyglass Loom's Skyglass, the Conductor and a second hero. It costs Marrow, so build a Siphon first."),
            ],
            tips: [
                (icon: Grub, text: "Tune the nearest seep with your starting Resonator; each Resonator tunes one seep."),
                (icon: Marrow, text: "Build a Siphon early so you have the Marrow for the Cathedral upgrade."),
                (icon: Alarm, text: "Keep it away from the front; it is the only building that trains Tuners and Conductors."),
            ],
        ),
        (
            name: "Cathedral",
            blurb: "Tier 2 of the Spire: unlocks the Skyglass Loom and tier-2 regiments. Keeps working while it upgrades.",
            summary: "The Spire's second tier. It keeps working while it upgrades, raises your supply cap and unlocks the Skyglass Loom and every tier-2 regiment. Upgrade again for the Monolith once your chords are running.",
            notes: [
                ("Grand Organ", "The late game: the Monolith monster, the third hero and the top upgrades (not designed yet). Expensive, so upgrade once several chords pay your way."),
            ],
            tips: [
                (icon: Marrow, text: "Build a Siphon on a Marrow vein first, because the upgrade costs 100 Marrow."),
                (icon: Sword, text: "Queue Harmonic Walkers and Glass Striders at the Forge as soon as the upgrade finishes."),
                (icon: Supply, text: "Upgrade before your supply cap holds back your army; it adds 14 to the cap."),
            ],
        ),
        (
            name: "Grand Organ",
            blurb: "Tier 3 of the Spire: lets the Forge of Facets build the Monolith and opens the third hero slot.",
            summary: "The final tier of the main building. It raises the supply cap again, lets the Forge of Facets build the Monolith and opens the third hero slot. Nothing is left to upgrade, so spend on chords, armies and defence.",
            notes: [],
            tips: [
                (icon: Grub, text: "Wait until several chords pay for its 600 Grub and 250 Marrow before you upgrade."),
                (icon: Attack, text: "Once it finishes, queue the Monolith at the Forge of Facets for slow siege work."),
                (icon: Alarm, text: "Guard it closely, because the Monolith and the third hero are locked behind it."),
            ],
        ),
        (
            name: "Resonator",
            blurb: "Makes Grub from its nearest seep with no workers; powers buildings within 6 tiles. Build in triangles for chords.",
            summary: "Tunes its nearest free seep within 4 tiles to make Grub with no workers, powers buildings within 6 tiles, and links with Resonators within 14 tiles. Three linked Resonators make a chord that speeds the seeps inside it and charges Resonance. Build them in triangles at your seeps.",
            notes: [],
            tips: [
                (icon: Grub, text: "Place each Resonator within 4 tiles of a free seep, since each Resonator tunes one seep for Grub."),
                (icon: Flag, text: "Build three Resonators in a triangle within 14 tiles of each other to form a chord."),
                (icon: Alarm, text: "Site Resonators so they power Forges and Sanctums within 6 tiles; both need power."),
            ],
        ),
        (
            name: "Siphon",
            blurb: "Draws Marrow from a vein within 3 tiles with no workers. Build one on every Marrow vein you hold.",
            summary: "A Resonator built against a Marrow vein (within 3 tiles): it draws Marrow with no workers, and also links chords and powers buildings. Build one on every Marrow vein you hold; tier-2 buildings and units cost Marrow.",
            notes: [],
            tips: [
                (icon: Marrow, text: "Place it within 3 tiles of a Marrow vein; it draws about 40 Marrow a minute with no workers."),
                (icon: Marrow, text: "Take every Marrow vein you can, since tier-2 buildings, units and heroes all cost Marrow."),
                (icon: Grub, text: "Like a Resonator, it links chords, so keep it within 14 tiles of your other Resonators."),
            ],
        ),
        (
            name: "Forge of Facets",
            blurb: "Builds every Choir walker and the Monolith. Needs power; raise it as soon as your economy runs.",
            summary: "Builds every Choir regiment that walks: Shardlings, Prism Lancers, Harmonic Walkers, Glass Striders and the Monolith. Needs power. It is the heart of your army, so raise it inside a powered field as soon as the economy runs.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Raise it inside a powered field, since it needs power before it can train any regiment."),
                (icon: Sword, text: "Train Shardlings as a cheap screen and stand Prism Lancers behind them to split their volleys."),
                (icon: Marrow, text: "Bank Marrow for Harmonic Walkers and Glass Striders, which both cost Marrow to train here."),
            ],
        ),
        (
            name: "Harmonics Lab",
            blurb: "Nothing to research yet: Choir upgrades are not designed or built. Needs power. Plan one for later.",
            summary: "Meant to research Choir upgrades. No upgrades are designed or built yet, so today it does nothing you can buy. Needs power. Plan one for when research arrives.",
            notes: [
                ("Research", "Upgrades are planned for the Harmonics Lab. No research, costs or times are designed or built yet, so nothing can be bought here today."),
            ],
            tips: [
                (icon: Grub, text: "Skip it for now; no upgrades are built yet, so its 175 Grub is better spent on Resonators."),
                (icon: Book, text: "Plan a spot inside a powered field now, so it is ready once research is added."),
            ],
        ),
        (
            name: "Skyglass Loom",
            blurb: "Builds Skyglass, the Choir's flyers, which hit air regiments hard. Tier 2, needs Marrow and power.",
            summary: "Builds Skyglass, the Choir's flyers. Tier 2, needs Marrow and power. Build one to win the air, to hunt artillery and archers, or to counter enemy flyers: Skyglass deal extra damage to air regiments.",
            notes: [],
            tips: [
                (icon: Alarm, text: "Build it when the enemy fields flyers, since Skyglass deal 50% more damage to air regiments."),
                (icon: Marrow, text: "Keep spare Marrow for the Loom and each Skyglass, since both cost Marrow."),
                (icon: Attack, text: "Send Skyglass after enemy artillery and workers, the targets they are built to raid."),
            ],
        ),
        (
            name: "Bell Tower",
            blurb: "A beam tower that hits ground and air. When enemies come near it silences their faction powers. Needs power.",
            summary: "A beam tower that hits ground and air. When enemies come within 10 tiles it tolls (at most once every 20 seconds) and silences their faction powers there for 5 seconds, which shuts down hero spells and unit powers at your gates. Needs power, so keep it inside a field.",
            notes: [],
            tips: [
                (icon: Alarm, text: "Place it where enemy heroes will push, since its toll silences their abilities within 10 tiles."),
                (icon: Charge, text: "Time your charges for right after a toll, while enemy hero spells and faction powers are silenced."),
                (icon: Hammer, text: "Keep it inside a powered field, since it needs power, and it hits air as well as ground."),
            ],
        ),
        (
            name: "Prism Lance",
            blurb: "A bolt tower: its beam runs on through up to 3 more enemy regiments in line.",
            summary: "Bolt tower: one heavy bolt every 5 seconds that runs down a single file of soldiers, twice as hard on monsters, riders and engines. Its beam runs on through up to 3 more enemy regiments in line behind the target. It shoots siege engines first, then big soldiers. Needs power, so keep it inside a field.",
            notes: [],
            tips: [
                (icon: Flag, text: "Place it where enemy columns will march, so its beam runs through several regiments."),
                (icon: Hammer, text: "Keep it inside a powered field, since it does nothing without power."),
                (icon: Spear, text: "Weak against wide lines of small soldiers, so guard it with spears."),
            ],
        ),
        (
            name: "Chord Obelisk",
            blurb: "A blast tower: six shots into the fullest enemy block in range. Blind up close.",
            summary: "Blast tower: six shots every 5 seconds into the fullest enemy block in range, harder the more packed it is, with half splashing on nearby regiments. Siege engines first. It cannot hit enemies within 8 tiles of it, so guard it with troops. Its sound burst throws every regiment it hits into disorder until they re-form. Needs power.",
            notes: [],
            tips: [
                (icon: Charge, text: "Charge the regiments it throws into disorder, since they fight worse until they re-form."),
                (icon: Spear, text: "Guard it with troops, since nothing within 8 tiles of it can be hit."),
                (icon: Hammer, text: "Keep it inside a powered field, since it needs power to fire."),
            ],
        ),
        (
            name: "Sanctum of Echoes",
            blurb: "Builds and restores heroes: the Maestro, Refractor and Hollow Bell. Needs power; build it early.",
            summary: "Builds and restores heroes: the Maestro, the Refractor and the Hollow Bell. Needs power. Build it early; the Maestro boosts chords and the others turn fights. Heroes cost Marrow, so keep some in reserve for a replacement.",
            notes: [],
            tips: [
                (icon: Heart, text: "Keep spare Marrow in reserve here, because heroes cost Marrow to build or restore."),
                (icon: Grub, text: "Keep the Maestro near your chords, not the front, so Harmony adds Grub from them."),
                (icon: Sword, text: "Pair the Refractor with Prism Lancers for damage, and the Hollow Bell for stuns and morale."),
            ],
        ),
        (
            name: "Light Curtain",
            blurb: "A wall of light you draw inside your power. Your troops walk through it; enemies can't, until the power fails.",
            summary: "A wall of light you draw inside your power: press and drag for a smooth curve, or click corner to corner for sharp ones; right-click to finish. Shift keeps it straight. Your own troops walk straight through it, so the Choir needs no gates. Enemies can't, until its power is cut and it drops.",
            notes: [
                ("Glass Wall", "Twice and a half as tough, still open to your own troops. Keep its power safe."),
            ],
            tips: [
                (icon: Move, text: "Your army marches through your own curtains, so wall every way in and keep moving freely."),
                (icon: Alarm, text: "Guard the Resonators that power it: lose them and the curtain drops for everyone."),
                (icon: Hammer, text: "B plans it as a blueprint (press A with Tuners selected to build it); O rings your base."),
            ],
        ),
        (
            name: "Glass Wall",
            blurb: "Tier 2 of the Light Curtain: 2.5 times as tough, and your troops still pass. Select a curtain and press U.",
            summary: "Level 2 of the Light Curtain: solid crystal, 2.5 times as tough. Your troops still walk through it and it still drops without power. Select a curtain and press U: the joined stretch is paid now and raised a tile at a time.",
            notes: [
                ("Singing Wall", "The Choir's toughest wall: four times a Light Curtain. Needs tier 2."),
            ],
            tips: [
                (icon: Hammer, text: "Select the curtain and press U: the joined stretch is paid now, then raised a tile at a time."),
                (icon: Alarm, text: "It still drops without power, so guard the pylons behind it."),
                (icon: Flag, text: "Right-click it with foot or archers to man it: they shoot further and take half from arrows."),
            ],
        ),
        (
            name: "Singing Wall",
            blurb: "Tier 3 of the Light Curtain: 4 times as tough; its song slows whoever strikes it. Needs tier 2; press U on a Glass Wall.",
            summary: "Level 3, the top: humming crystal, 4 times as tough as a Light Curtain. Needs tier 2. Your troops walk through it; it drops without power. Select a Glass Wall and press U. Its twist: its song slows whoever strikes it for 3 s, to half as many blows and a slower walk.",
            notes: [],
            tips: [
                (icon: Alarm, text: "Right-click an enemy raised wall with foot or archers to climb it; spears stop climbers."),
                (icon: Grub, text: "Each tile costs 20 Grub and 5 Marrow, paid for the whole stretch up front."),
                (icon: Flag, text: "Right-click it with foot or archers to man it: they shoot further and take half from arrows."),
            ],
        ),
        (
            name: "Glass Span",
            blurb: "Draw a glass span across a river. It needs no power; workers build it from the bank, and anyone can cross it.",
            summary: "You draw it across a river: drag from bank to bank along a gentle curve, or click each bank for a straight one. [ and ] pick narrow, standard or wide (3 to 5 tiles), 3 Grub a tile. It needs no power. Workers build it out from the bank. Anyone can cross it; a broken tile drops its troops into the river.",
            notes: [
                ("Braced Glass Span", "Twice as tough against blows; later, debris in the river too."),
            ],
            tips: [
                (icon: Hammer, text: "Drag from dry land to dry land; it bends gently. [ and ] pick the width."),
                (icon: Move, text: "A worker builds it from the bank and carries on across the river a tile at a time."),
                (icon: Alarm, text: "Enemies can cross it too, so guard it. A tile that falls drops troops into the river."),
            ],
        ),
        (
            name: "Braced Glass Span",
            blurb: "Tier 2 of the Glass Span: twice as tough. Select a span and press U to raise the whole joined bridge.",
            summary: "Level 2 of the Glass Span: braced glass struts under the deck, twice as tough. Select a span and press U: the whole joined span is paid now and raised a tile at a time, and troops keep crossing meanwhile.",
            notes: [
                ("Anchored Glass Span", "More than three times as tough, and debris glances off its footings."),
            ],
            tips: [
                (icon: Hammer, text: "Select the bridge and press U: the joined bridge is paid now, then raised a span at a time."),
                (icon: Move, text: "Troops keep crossing while it is raised; the deck never closes."),
                (icon: Alarm, text: "Upgrade bridges on rivers an enemy can reach first: they take blows and debris best."),
            ],
        ),
        (
            name: "Anchored Glass Span",
            blurb: "Tier 3 of the Glass Span: over three times as tough, and it sheds debris. Needs tier 2; press U on a braced span.",
            summary: "Level 3, the top: resonant stone anchors with prow-shaped footings, more than three times a plain span's toughness, and it sheds debris instead of catching it. Needs tier 2. Select a Braced Glass Span and press U.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Select the bridge and press U: the joined bridge is paid now, then raised a span at a time."),
                (icon: Move, text: "Troops keep crossing while it is raised; the deck never closes."),
                (icon: Alarm, text: "Upgrade bridges on rivers an enemy can reach first: they take blows and debris best."),
            ],
        ),
        (
            name: "Shard Stakes",
            blurb: "Draw shards that stop enemy riders and beasts dead; foot troops pass at half pace. Wears down each time.",
            summary: "A line of glass shards set point up that you draw like a wall, at any angle, for 4 Grub a tile. Anyone walks through at half pace, but nobody charges through: enemy riders and beasts that run onto it are stopped dead, hurt and disordered. It wears down each time.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Draw it like a wall, at any angle. It costs little and goes up fast."),
                (icon: Spear, text: "Spearmen and archers can plant a free line with Plant stakes (C): stand 10 s."),
                (icon: Alarm, text: "Ranks that charge into it are stopped dead; keep your own charges off it."),
            ],
        ),
        (
            name: "Glass Barricade",
            blurb: "Draw a barricade nobody walks through; troops behind it take less from arrows and blows.",
            summary: "A line of thick glass slabs you draw like a wall, for 8 Grub a tile. It blocks walking like a wall, and your troops within 2 tiles of it take 30 percent less from arrows and 20 percent less from blows to their front. Enemy troops get no cover from it.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Draw it like a wall, at any angle. It costs little and goes up fast."),
                (icon: Bow, text: "Put your archers and spears within 2 tiles behind it to take the cover."),
                (icon: Alarm, text: "It blocks your own troops too, so leave a gap where your line must pass."),
            ],
        ),
        (
            name: "Shard Mine",
            blurb: "A hidden trap: the first enemy regiment to step on it is stunned for 4 seconds. Gone once sprung.",
            summary: "A half-buried shard for 20 Grub on one tile. The first enemy regiment to walk onto it is stunned for 4 seconds: it halts, falls into disorder and cannot move. It needs no power. Your enemies cannot see it, and once it is sprung it is gone.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Built by a worker like any building, on one tile. Nothing can be built on it."),
                (icon: Alarm, text: "Only you can see it. Enemies never see it, not even in the open."),
                (icon: Bow, text: "Stun a regiment in front of your line. Your own troops walk over it safely."),
            ],
        ),
    ],
    units: [
        (
            name: "Tuner",
            tagline: "Builder: raises and mends structures, does not gather.",
            summary: "The Choir's worker. It builds Choir structures inside a Resonator's field and repairs them, but does not gather: Resonators and Siphons make your income. Train a few to build and mend, not a swarm. They can also clear woods, scrub and thicket (S). Tuners shatter it: thicket goes as fast as woods, but it pays no timber.",
        ),
        (
            name: "Shardlings",
            tagline: "Crystal swarm infantry: each death bursts for damage.",
            summary: "Fast crystal infantry. Shatter bursts each fallen model into shards that hurt enemies within 1.5 tiles, so crushing them costs the enemy. They run down archers and artillery but lose to heavy infantry. Cheap, so they screen your Prism Lancers.",
        ),
        (
            name: "Prism Lancers",
            tagline: "Beam ranged unit: volleys split through Crystal allies.",
            summary: "Crystal archers who fire beams. A volley that passes through an allied Crystal regiment splits into two weaker volleys at the nearest enemies behind it, so stand them behind Shardlings. Good against infantry in the open; weak to cavalry and flyers.",
        ),
        (
            name: "Harmonic Walkers",
            tagline: "Heavy crystal infantry: Sonic Pulse knocks lines back.",
            summary: "Armoured walkers. Sonic Pulse hits a cone: enemies are knocked back 3 tiles, lose morale and have their melee defence cut while they re-form. Use it to break a charge or open a line. Heavy infantry beat light units and spears; ranged fire and monsters beat them.",
        ),
        (
            name: "Glass Striders",
            tagline: "Cavalry: Phase Charge blinks into contact.",
            summary: "Fast crystal cavalry. Phase Charge blinks straight into an enemy regiment and counts as a full-speed charge. Strong against archers and artillery behind a screen; spears and braced lines stop them. Needs Marrow and power.",
        ),
        (
            name: "Skyglass",
            tagline: "Flyers: extra damage to other flyers.",
            summary: "Fast crystal flyers. Glint adds 50% damage against air regiments, making them the Choir's answer to enemy flyers, and they raid artillery and workers. Archers and other air units are their enemies. Built at a Skyglass Loom.",
        ),
        (
            name: "Conductor",
            tagline: "Support: a mobile Resonator that heals Crystal regiments.",
            summary: "A support unit built at the Spire. Mobile Resonator anchors it in 3 seconds, after which it links chords, powers structures and tunes a seep like a Resonator. Its Tuning Fork aura slowly heals Crystal regiments. Fragile, so keep it behind the line.",
        ),
        (
            name: "Monolith",
            tagline: "Monster: sonic beam breaks buildings, terror aura.",
            summary: "A slow tier-3 monster. Its Sonic Beam deals triple damage to structures at range, and its Terror Aura bleeds enemy morale within 10 tiles. Bring it to siege a base. Focused ranged fire and heroes bring it down. Built at the Forge of Facets.",
        ),
        (
            name: "The Maestro",
            tagline: "Hero of economy: boosts chords and army reload.",
            summary: "An economy hero. Crescendo speeds reloading and adds melee attack, Retune moves a Resonator instantly, Harmony adds Grub to chords near him, and Symphony doubles your chords' Grub for a time. Keep him near your chords, not in the front.",
        ),
        (
            name: "The Refractor",
            tagline: "Hero of damage: splits beams, reflects volleys.",
            summary: "A damage hero. Split Beam sends his volleys at several targets, Mirror Shield reflects incoming volleys back, Lens lets a non-Crystal regiment refract beams, and Prismatic Lance cuts a line through everything in it. Pair with Prism Lancers.",
        ),
        (
            name: "The Hollow Bell",
            tagline: "Hero of control: stuns, silences, shatters morale.",
            summary: "A control hero. Toll stuns a regiment, Silence switches off abilities in an area, Echo Step blinks him across the field, and Deafening Peal drops the morale of every enemy regiment in range at once. Time Peal for the moment your charge lands.",
        ),
    ],
)
