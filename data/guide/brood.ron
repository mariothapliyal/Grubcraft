// Guide text for the Brood. Format and rules: see ember_clans.ron.
(
    faction: Brood,
    buildings: [
        (
            name: "Hive",
            blurb: "Your starting base: holds 3 larvae, spawns one every 12 seconds and carries Grub from seeps. Hatches all regiments.",
            summary: "Your starting base. It holds 3 larvae and spawns one every 12 seconds, and every regiment hatches from a larva, so larvae often limit your army before Grub does. Its root-veins carry Grub from your seeps. Upgrade to the Great Hive for evolutions, flyers and artillery. Workers clear woods and scrub (S) to make room; cleared ground is open.",
            notes: [
                ("Great Hive", "The gate to the mid game: the Chrysalis Chamber's evolutions, Drone-Moths, the Broodmother Bulk and a second hero. Upgrading uses no Gnawer, but it costs Marrow."),
            ],
            tips: [
                (icon: Grub, text: "Send Gnawers into the nearest seeps early, since their Grub funds everything else."),
                (icon: Marrow, text: "Bank 100 Marrow for the Great Hive, which needs no Gnawer but does cost Marrow."),
                (icon: Hammer, text: "Watch the larva count; once Grub piles up with no larvae free, grow a Hatchery Pit."),
            ],
        ),
        (
            name: "Great Hive",
            blurb: "Tier 2 of the Hive: unlocks the Chrysalis Chamber, Moth Roost and Gorge. Keeps spawning larvae while it upgrades.",
            summary: "The Hive's second tier. It keeps spawning larvae while it upgrades, raises your supply cap, and unlocks the Chrysalis Chamber, Moth Roost and Gorge. Upgrade again for the Colossus Maw once your economy is solid.",
            notes: [
                ("Throne Hive", "The late game: the Colossus Maw monster, the third hero and the top upgrades (not designed yet). Costly in Grub and Marrow, so build it when you hold a second base."),
            ],
            tips: [
                (icon: Hammer, text: "Upgrade as soon as you can afford it, since larvae keep hatching during the upgrade."),
                (icon: Supply, text: "Use the higher supply cap to mass tier-1 regiments, then evolve them at the Chrysalis Chamber."),
                (icon: Marrow, text: "Keep Marrow back for the Chrysalis Chamber, Moth Roost and Gorge, which all need it."),
            ],
        ),
        (
            name: "Throne Hive",
            blurb: "Tier 3 of the Hive: lets the Gorge hatch the Colossus Maw and opens the third hero slot.",
            summary: "The final tier of the main building. It raises the supply cap again, lets the Gorge hatch the Colossus Maw and opens the third hero slot. Nothing is left to upgrade, so spend on larvae, armies and defence.",
            notes: [],
            tips: [
                (icon: Skill, text: "Hire the third hero at the Queen's Chamber, since this tier opens that slot."),
                (icon: Brace, text: "Defend it with an army and Spine Mounds; at 4200 HP it has the most of any building."),
                (icon: Attack, text: "Pair it with a Gorge, which can hatch the Colossus Maw now that this tier is up."),
            ],
        ),
        (
            name: "Pustule",
            blurb: "Housing that carries root-veins 8 tiles further, so far seeps keep delivering Grub. Build a line of them to expand.",
            summary: "Housing that also carries the root-veins 8 tiles further, so far seeps keep delivering Grub. Kill one and every seep beyond it stops delivering, so guard the chain. Build a line of them to expand, and a few extra for supply.",
            notes: [],
            tips: [
                (icon: Grub, text: "Chain Pustules out toward far seeps, since their root-veins bring that Grub home."),
                (icon: Alarm, text: "Guard the chain with Spine Mounds, because one dead Pustule cuts off every seep beyond."),
                (icon: Supply, text: "Add a few spare Pustules for supply; each gives 8 supply for only 40 Grub."),
            ],
        ),
        (
            name: "Hatchery Pit",
            blurb: "Holds 3 more larvae and spawns its own. Build a few when Grub piles up and the Hive has no larvae left.",
            summary: "Holds 3 more larvae and spawns its own every 12 seconds. Each pit raises how fast you can field regiments. Build a few when Grub piles up while the Hive has no larvae left.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Build a few rather than one; each pit adds 3 larvae and spawns its own every 12 s."),
                (icon: Move, text: "Place pits close to the front so fresh regiments reach the fight quickly."),
                (icon: Alarm, text: "Guard pits with Spine Mounds; a destroyed pit loses its 3 larvae and its spawning."),
            ],
        ),
        (
            name: "Chrysalis Chamber",
            blurb: "Lets tier-1 regiments cocoon into their tier-2 forms anywhere, for extra Grub and Marrow. Tier 2.",
            summary: "Unlocks evolutions: tier-1 regiments can cocoon into their tier-2 forms anywhere on the field. Tier 2, and each evolution costs extra Grub and Marrow and 15 seconds in the cocoon. Build it to turn swarms into archers, burrowers, reapers or shellbacks.",
            notes: [],
            tips: [
                (icon: Marrow, text: "Bank Marrow first, since each evolution costs extra Grub and Marrow on top of its unit."),
                (icon: Hammer, text: "Start a cocoon before a clash, because each evolution takes 15 seconds in the cocoon."),
                (icon: Spear, text: "Evolve Chitin Guard into Mantid Reapers once the enemy fields cavalry or monsters."),
            ],
        ),
        (
            name: "Moth Roost",
            blurb: "Hatches Drone-Moths: fast flyers whose Spore Bombs spoil archers' aim and who spot burrowed units. Tier 2, needs Marrow.",
            summary: "Lets larvae hatch into Drone-Moths: fast flyers whose Spore Bombs spoil enemy archers' accuracy and whose antennae detect burrowed units. Tier 2 and needs Marrow. Build one to scout, to hunt artillery or to reveal stealth.",
            notes: [],
            tips: [
                (icon: Bow, text: "Send Drone-Moths at enemy archers, since Spore Bombs cut their ranged accuracy."),
                (icon: Alarm, text: "Station Moths near seeps and Burrowers, since antennae reveal burrowed units within 10 tiles."),
                (icon: Move, text: "Scout with Moths, but pull them back from enemy archers and flyers, which answer them."),
            ],
        ),
        (
            name: "Gorge",
            blurb: "Hatches Broodmother Bulks, your long-range artillery, and the Colossus Maw at tier 3. Tier 2, needs Marrow.",
            summary: "Lets larvae hatch into Broodmother Bulks, your long-range artillery, and at tier 3 the Colossus Maw. Tier 2 and needs Marrow. Build it once the front is steady and you want to outrange defenders or crack open a base.",
            notes: [],
            tips: [
                (icon: Brace, text: "Screen Broodmother Bulks with Chitin Guard, since flyers and cavalry can reach them."),
                (icon: Attack, text: "Aim Bulks at packed infantry from up to 45 tiles away, where their sacs burst over 2 tiles."),
                (icon: Alarm, text: "Keep the sacs away from your own lines, since their burst can hit friendly regiments too."),
            ],
        ),
        (
            name: "Spine Mound",
            blurb: "A static guard that flings spines at siege engines first, then attackers. Guards vein edges, Pustules and the Hive.",
            summary: "Flings spines at ground and air: siege engines first, then whoever attacks your buildings, then the nearest. Right-click an enemy with it selected to pick its target. A cheap static guard for vein edges, Pustules and your Hive. It is Living, so it regrows while on root-veins, but it will not stop an army. Pair with Shellbacks and Chitin Guard.",
            notes: [
                ("Spine Bastion", "Level 2 at tier 2, upgraded in place with V: 1.5 times the hit points, more damage a shot and 4 tiles more range."),
            ],
            tips: [
                (icon: Heart, text: "Build them on root-veins, where the Living mound regrows between fights."),
                (icon: Alarm, text: "Place them on vein edges and beside Pustules and the Hive to guard the approaches."),
                (icon: Brace, text: "Pair them with Chitin Guard, so the line holds while the mounds shoot over it."),
            ],
        ),
        (
            name: "Spine Bastion",
            summary: "Level 2 of the Spine Mound, upgraded in place. Its spines hit for 13 (up from 10), reach 34 tiles (up from 30) and the tower has 1350 hit points (up from 900). It still flings spines at ground and air. It costs 60 Grub and 50 Marrow. Press V on a finished Spine Mound (tier 2); it takes 30 seconds and keeps firing.",
            notes: [],
            tips: [
                (icon: Heart, text: "Build it on root-veins, since the Living bastion still regrows between fights."),
                (icon: Marrow, text: "Save 50 Marrow for it, since the upgrade costs 60 Grub and 50 Marrow."),
                (icon: Brace, text: "Pair it with Chitin Guard, so the line holds while the bastion shoots over it."),
            ],
        ),
        (
            name: "Harpoon Maw",
            blurb: "Bolt tower: a heavy bolt down a file of soldiers that drags its target 3 tiles toward the tower.",
            summary: "Bolt tower: one heavy bolt every 6 seconds that runs down a single file of soldiers, twice as hard on monsters, riders and engines. It shoots siege engines first, then big soldiers. Its harpoon drags the regiment it hits 3 tiles toward the tower and halts it, unless that regiment is locked in melee or standing on a wall.",
            notes: [
                ("Harpoon Gullet", "Level 2 at tier 2, upgraded in place with V: 1.5 times the hit points, more damage a shot and 4 tiles more range."),
            ],
            tips: [
                (icon: Flag, text: "Place it where columns will walk into range, since the harpoon pulls them 3 tiles in."),
                (icon: Brace, text: "Keep spears near it, since a regiment locked in melee cannot be dragged."),
                (icon: Heart, text: "Living armour, so it regrows on root-veins between fights, like the Spine Mound."),
            ],
        ),
        (
            name: "Harpoon Gullet",
            summary: "Level 2 of the Harpoon Maw, upgraded in place. Its bolt hits for 42 (up from 32), reaches 36 tiles (up from 32) and the tower has 1425 hit points (up from 950). Its harpoon still drags the regiment it hits 3 tiles in. It costs 95 Grub and 50 Marrow. Press V on a finished Harpoon Maw (tier 2); it takes 30 seconds and keeps firing.",
            notes: [],
            tips: [
                (icon: Flag, text: "Place it where columns will walk into range, since the harpoon pulls them 3 tiles in."),
                (icon: Marrow, text: "Save 50 Marrow for it, since the upgrade costs 95 Grub and 50 Marrow."),
                (icon: Brace, text: "Keep spears near it, since a regiment locked in melee cannot be dragged."),
            ],
        ),
        (
            name: "Acid Bloater",
            blurb: "Blast tower: shells packed blocks and leaves acid pools. Blind within 8 tiles, so guard it.",
            summary: "Blast tower: six shots every 6 seconds into the fullest enemy block in range, harder the more packed it is, with half splashing on nearby regiments. Siege engines first. It cannot hit enemies within 8 tiles of it, so guard it with troops. It leaves a pool of acid for 6 seconds that eats at any enemy standing in it.",
            notes: [
                ("Acid Gorger", "Level 2 at tier 2, upgraded in place with V: 1.5 times the hit points, more damage a shot and 4 tiles more range."),
            ],
            tips: [
                (icon: Alarm, text: "Acid eats at enemies standing in the pool, so it is best against crowds that stay put."),
                (icon: Brace, text: "Guard it with Chitin Guard, since nothing within 8 tiles of it can be hit."),
                (icon: Heart, text: "Living armour, so it regrows on root-veins between fights."),
            ],
        ),
        (
            name: "Acid Gorger",
            summary: "Level 2 of the Acid Bloater, upgraded in place. It fires six shots every 6 seconds, 5 damage each (up from 4), reaches 40 tiles (up from 36) and has 1275 hit points (up from 850). Its acid pool still eats at enemies standing in it. It costs 115 Grub and 75 Marrow. Press V on a finished Acid Bloater (tier 2); it takes 30 seconds and keeps firing.",
            notes: [],
            tips: [
                (icon: Alarm, text: "Acid eats at enemies standing in the pool, so it is best against crowds that stay put."),
                (icon: Marrow, text: "Save 75 Marrow for it, since the upgrade costs 115 Grub and 75 Marrow."),
                (icon: Brace, text: "Guard it with Chitin Guard, since nothing within 8 tiles of it can be hit."),
            ],
        ),
        (
            name: "Queen's Chamber",
            blurb: "Hatches and revives heroes: the Queen-in-Waiting, Devourer and Whisperer. Build it early; heroes cost Marrow.",
            summary: "Hatches and revives heroes. Build it early: the Queen-in-Waiting, the Devourer and the Whisperer lead the brood and each turns a fight. Heroes cost Marrow too, so keep some in reserve for a replacement.",
            notes: [],
            tips: [
                (icon: Skill, text: "Build it early so your first hero is ready to turn the opening fights."),
                (icon: Marrow, text: "Keep Marrow in reserve, so a fallen hero can be replaced without stalling the army."),
                (icon: Heart, text: "Hire the Queen-in-Waiting for healing and haste, since she supports the whole army."),
            ],
        ),
        (
            name: "Resin Ridge",
            blurb: "A wall the Hive grows along its root-veins. It needs no Gnawer and heals on the veins.",
            summary: "A wall the Hive grows: press and drag for a smooth curve, or click corner to corner for sharp ones; right-click to finish. It goes only where your root-veins reach, takes no Gnawer and grows every tile at once. It heals on the veins and withers off them.",
            notes: [
                ("Chitin Wall", "Twice and a half as tough, grown with no Gnawer while the veins reach it."),
            ],
            tips: [
                (icon: Hammer, text: "Spread veins first: a ridge grows only where your root-veins reach."),
                (icon: Alarm, text: "Cut the veins under an enemy ridge and it withers away on its own."),
                (icon: Move, text: "Press O to ring your hive: every tile grows at once and the ring leans on cliffs."),
            ],
        ),
        (
            name: "Chitin Wall",
            blurb: "Tier 2 of the Resin Ridge: 2.5 times as tough. Select a ridge and press U; it grows on its own along the veins.",
            summary: "Level 2 of the Resin Ridge: overlapping chitin plates, 2.5 times as tough. Select a ridge and press U: the joined stretch is paid now and grows up on its own while the veins reach it, with no Gnawer.",
            notes: [
                ("Thorn Bulwark", "The Brood's toughest wall: four times a Resin Ridge. Needs tier 2."),
            ],
            tips: [
                (icon: Flag, text: "Right-click it with foot or archers to man it: they shoot further and take half from arrows."),
                (icon: Hammer, text: "Select the ridge and press U: the joined stretch is paid now and grows up on its own."),
                (icon: Alarm, text: "Cut off from the veins it stops growing, so guard the relays behind it."),
            ],
        ),
        (
            name: "Thorn Bulwark",
            blurb: "Tier 3 of the Resin Ridge: 4 times as tough, and each melee blow costs the striker 3 hit points. Needs tier 2.",
            summary: "Level 3, the top: a spined bulwark, 4 times as tough as a Resin Ridge. Needs tier 2. Select a Chitin Wall and press U; it grows on its own while the veins reach it. Its twist: each melee blow on it costs the striker 3 hit points; archers are spared.",
            notes: [],
            tips: [
                (icon: Flag, text: "Right-click it with foot or archers to man it: they shoot further and take half from arrows."),
                (icon: Alarm, text: "Right-click an enemy raised wall with foot or archers to climb it; spears stop climbers."),
                (icon: Grub, text: "Each tile costs 20 Grub and 5 Marrow, paid for the whole stretch up front."),
            ],
        ),
        (
            name: "Maw Gate",
            blurb: "A gate in your Resin Ridge: your side walks through and enemies don't. Set it Auto, Locked or Open.",
            summary: "A gate in your Resin Ridge: your side walks through and enemies don't. A Gnawer is used up growing it, as for any Brood building. Select it to set Auto (opens as your regiments march up, shuts 2 s after; troops in the gateway hold it open), Locked (shut to everyone) or Open (anyone can pass).",
            notes: [
                ("Chitin Maw", "Half as tough again, with a ridge of chitin on top for archers or foot. It grows on its own, with no Gnawer, and the jaws keep working."),
            ],
            tips: [
                (icon: Flag, text: "Select it, then Q, W or E: Auto, Locked or Open. Lock it under attack; open it for a sally."),
                (icon: Hammer, text: "Place it on your own Resin Ridge and it replaces that stretch: R turns it to run along the wall."),
                (icon: Hammer, text: "Press V to raise it to a Chitin Maw: archers or foot can man the ridge on top."),
            ],
        ),
        (
            name: "Chitin Maw",
            blurb: "Tier 2 of the Maw Gate: half as tough again, with a ridge walkway. Select a Maw Gate and press V.",
            summary: "Level 2 of the Maw Gate: a plated arch with a ridge of chitin on top, half as tough again. Select a Maw Gate and press V: it grows on its own, with no Gnawer, and the jaws keep working. Archers or foot can man the ridge, and it joins a raised wall beside it into one walkway.",
            notes: [],
            tips: [
                (icon: Flag, text: "Alt+right-click it with foot or archers to man it: they shoot further, take half from arrows."),
                (icon: Alarm, text: "Enemies can climb it on ladders; spears stop climbers. Lock the jaws under attack."),
                (icon: Move, text: "A raised wall touching it joins its ridge, so one regiment can hold both."),
            ],
        ),
        (
            name: "Chitin Span",
            blurb: "Draw a chitin span across a river. Gnawers build it from the bank, and anyone can cross it.",
            summary: "You draw it across a river: drag from bank to bank along a gentle curve, or click each bank for a straight one. [ and ] pick narrow, standard or wide (3 to 5 tiles), 3 Grub a tile. Gnawers build it out from the bank a plate at a time. Anyone can cross it; a broken tile drops its troops into the river.",
            notes: [
                ("Ribbed Chitin Span", "Twice as tough against blows; later, debris in the river too."),
            ],
            tips: [
                (icon: Hammer, text: "Drag from dry land to dry land; it bends gently. [ and ] pick the width."),
                (icon: Move, text: "A Gnawer builds it from the bank and carries on across the river a tile at a time."),
                (icon: Alarm, text: "Enemies can cross it too, so guard it. A tile that falls drops troops into the river."),
            ],
        ),
        (
            name: "Ribbed Chitin Span",
            blurb: "Tier 2 of the Chitin Span: twice as tough. Select a span and press U to raise the whole joined bridge.",
            summary: "Level 2 of the Chitin Span: ribbed chitin struts grown under the deck, twice as tough. Select a span and press U: the whole joined span is paid now and Gnawers raise it a plate at a time, and troops keep crossing meanwhile.",
            notes: [
                ("Rooted Chitin Span", "More than three times as tough, and debris glances off its prows."),
            ],
            tips: [
                (icon: Hammer, text: "Select the bridge and press U: the joined bridge is paid now, then raised a span at a time."),
                (icon: Move, text: "Troops keep crossing while it is raised; the deck never closes."),
                (icon: Alarm, text: "Upgrade bridges on rivers an enemy can reach first: they take blows and debris best."),
            ],
        ),
        (
            name: "Rooted Chitin Span",
            blurb: "Tier 3 of the Chitin Span: over three times as tough, and it sheds debris. Needs tier 2; press U on a ribbed span.",
            summary: "Level 3, the top: hardened carapace piers with pointed prows, more than three times a plain span's toughness, and it sheds debris instead of catching it. Needs tier 2. Select a Ribbed Chitin Span and press U.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Select the bridge and press U: the joined bridge is paid now, then raised a span at a time."),
                (icon: Move, text: "Troops keep crossing while it is raised; the deck never closes."),
                (icon: Alarm, text: "Upgrade bridges on rivers an enemy can reach first: they take blows and debris best."),
            ],
        ),
        (
            name: "Spine Stakes",
            blurb: "Draw spines that stop enemy riders and beasts dead; foot troops pass at half pace. Wears down each time.",
            summary: "A line of hardened spines you draw like a wall, at any angle, for 4 Grub a tile. Anyone walks through at half pace, but nobody charges through: enemy riders and beasts that run onto it are stopped dead, hurt and disordered. It wears down each time.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Draw it like a wall, at any angle. It costs little and goes up fast."),
                (icon: Spear, text: "Spearmen and archers can plant a free line with Plant stakes (C): stand 10 s."),
                (icon: Alarm, text: "Ranks that charge into it are stopped dead; keep your own charges off it."),
            ],
        ),
        (
            name: "Husk Barricade",
            blurb: "Draw a barricade nobody walks through; troops behind it take less from arrows and blows.",
            summary: "A line of piled husks you draw like a wall, for 8 Grub a tile. It blocks walking like a wall, and your troops within 2 tiles of it take 30 percent less from arrows and 20 percent less from blows to their front. Enemy troops get no cover from it.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Draw it like a wall, at any angle. It costs little and goes up fast."),
                (icon: Bow, text: "Put your archers and spears within 2 tiles behind it to take the cover."),
                (icon: Alarm, text: "It blocks your own troops too, so leave a gap where your line must pass."),
            ],
        ),
        (
            name: "Burrow Nest",
            blurb: "A hidden trap: the first enemy regiment to step on it wakes a Skitterling regiment for you for 30 seconds.",
            summary: "A resin-crusted burrow mound for 40 Grub on one tile. The first enemy regiment to walk onto it wakes the nest: a regiment of Skitterlings bursts out beside it for you and fights for 30 seconds. Your enemies cannot see it, and once it is sprung it is gone.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Built by a worker like any building, on one tile. Nothing can be built on it."),
                (icon: Alarm, text: "Only you can see it. Enemies never see it, not even in the open."),
                (icon: Sword, text: "The Skitterlings are yours, but only for 30 seconds. Your own troops walk over it safely."),
            ],
        ),
    ],
    units: [
        (
            name: "Gnawer",
            tagline: "Worker: burrows into seeps, or is spent to grow a building.",
            summary: "The Brood's worker. Burrow In sends it into a seep (5 at most), hidden and safe, delivering Grub down the vein network. Grow Structure uses it up to start a building, so every building costs a Gnawer as well as Grub. Hatch plenty early. They also clear land (S) by eating it: slower, but even scrub pays a little Grub.",
        ),
        (
            name: "Skitterlings",
            tagline: "Cheap swarm infantry; evolve into Spitters or Burrowers.",
            summary: "A fast, cheap swarm of 32 frail soldiers with a good charge: one loses to almost anyone, so they win by numbers. Swarm Instinct cuts the morale lost to casualties by 30%. They run down archers and artillery but lose to heavy infantry and spears. Evolve them at the Chrysalis Chamber once tier 2 arrives.",
        ),
        (
            name: "Chitin Guard",
            tagline: "Shielded line infantry; evolve into Reapers or Shellbacks.",
            summary: "Tough shielded infantry with the best defence of the Brood's tier-1 troops. Hunker adds defence at half speed. A solid anchor in front of ranged units. Evolve them into Mantid Reapers for offence or Shellbacks for defence. Weak to ranged fire and monsters.",
        ),
        (
            name: "Reclaimer",
            tagline: "Support: eats corpses for Grub, mends regiments.",
            summary: "A support unit. Digest eats a corpse every half second for 2 Grub each, and Mending Ooze slowly heals friendly regiments out of combat. Follow the army to turn battlefields into income. Poor in a fight and costs 2 supply, so protect it.",
        ),
        (
            name: "Spitters",
            tagline: "Evolved acid ranged unit: strips melee defence.",
            summary: "Evolved from Skitterlings. Acid cuts the melee defence of regiments they hit (stacking twice), softening a line for your melee troops. Ranged units punish infantry in the open but die to cavalry and flyers. Evolve a few behind your Chitin Guard.",
        ),
        (
            name: "Burrowers",
            tagline: "Evolved skirmishers: tunnel past cliffs and ambush.",
            summary: "Evolved from Skitterlings. Tunnel hides them and crosses cliffs and rib-ridges (slowly, and they cannot fight). Ambush makes their first 3 seconds after surfacing count as rear hits. Raid archers, artillery or a far seep. Drone-Moths and detectors reveal them.",
        ),
        (
            name: "Mantid Reapers",
            tagline: "Evolved spear line: deadly to cavalry and monsters.",
            summary: "Evolved from Chitin Guard. Heavy damage, spear reach, and 30% more against monsters on top of the spear bonus against cavalry. Less armour than the Guard, so keep them beside shields. Evolve a block when the enemy fields horse or monsters.",
        ),
        (
            name: "Shellbacks",
            tagline: "Evolved bulwark: roots in place, spines hit flyers.",
            summary: "Evolved from Chitin Guard. Very slow and very hard to hurt; Root locks them in place for more defence and longer spine range, but their spines can only target flyers. A living anti-air wall for your base or a choke point, not an attacker.",
        ),
        (
            name: "Drone-Moths",
            tagline: "Flyers: spore bombs cut accuracy, detect burrowed.",
            summary: "Fast flyers hatched at a Moth Roost. Spore Bombs cut the ranged accuracy of regiments hit, and their antennae detect burrowed and hidden units. Good for scouting and for hunting artillery and workers. Archers and other flyers answer them.",
        ),
        (
            name: "Broodmother Bulk",
            tagline: "Artillery: larva sacs that hatch Spawnlings.",
            summary: "A huge long-range artillery beast. Each larva sac bursts over 2 tiles (it can hit friends) and hatches a Spawnlings regiment at the impact for 20 seconds. Great against packed infantry, defenceless once cavalry or flyers reach it, so screen it.",
        ),
        (
            name: "Colossus Maw",
            tagline: "Monster: devours models to heal, terror aura.",
            summary: "A tier-3 monster. Devour swallows 3 models of a non-monster regiment it is fighting and heals it, and its Terror Aura bleeds enemy morale within 10 tiles. It crushes infantry; focused ranged fire and heroes bring it down. Hatched at the Gorge.",
        ),
        (
            name: "Spawnlings",
            tagline: "Summoned swarm: short-lived and never rout.",
            summary: "Hatched by Larva Sacs, Spawn Brood and Swarm Tide. A small, fast swarm that never routs and lasts 20 to 30 seconds. They cost no supply and cannot be trained; use them to pin enemies and soak arrows while your main force closes.",
        ),
        (
            name: "The Queen-in-Waiting",
            tagline: "Hero mother: hatches Spawnlings, heals, speeds the brood.",
            summary: "A support hero. Spawn Brood hatches extra regiments beside her, Royal Jelly heals a regiment, and Pheromone Trail speeds your troops. Swarm Tide makes the whole brood fight harder without losing morale. Keep her alive: losing a hero shakes nearby Brood regiments.",
        ),
        (
            name: "The Devourer",
            tagline: "Hero bruiser: eats models to heal, erupts from below.",
            summary: "A tough front-line brute. Gorge eats a model of a regiment it fights and heals; Grow makes it bigger with each kill; Burrow Charge tunnels in and erupts as a charge. Maw of the Titan kills a dozen models or smashes a monster or hero.",
        ),
        (
            name: "The Whisperer",
            tagline: "Hero controller: takes over regiments, sows confusion.",
            summary: "A fragile controller. Mind-Spore takes over a small enemy or creep regiment for a time, Confusion Cloud makes enemies fight each other, and Hive Sight lets every Pustule reveal the ground around it. Puppet Army turns every routing enemy against its own side.",
